import random
import time

# --- Data Models ---

class Student:
    def __init__(self, student_id, name, gender):
        self.student_id = student_id
        self.name = name
        self.gender = gender

    def __str__(self):
        return f"{self.name} (ID: {self.student_id})"


class Room:
    def __init__(self, room_number, capacity):
        self.room_number = room_number
        self.capacity = capacity
        self.occupants = []

    def add_student(self, student):
        if len(self.occupants) < self.capacity:
            self.occupants.append(student)
            return True
        return False

    def is_full(self):
        return len(self.occupants) >= self.capacity

    def __str__(self):
        occupant_list = ', '.join(str(s) for s in self.occupants)
        return f"Room {self.room_number}: {occupant_list}"


# --- Hostel Allotment System ---

class HostelAllotmentSystem:
    def __init__(self):
        self.students = []
        self.rooms = []
        self.room_capacity = 3  # Default capacity

    def register_students(self):
        print("\n--- Student Registration ---")
        try:
            total = int(input("Enter number of students to register: "))
            if total <= 0:
                print("Number must be greater than zero.")
                return
        except ValueError:
            print("Please enter a valid number.")
            return

        for i in range(total):
            print(f"\nStudent {i + 1}:")
            name = input("Name: ").strip()
            student_id = input("Student ID: ").strip()
            gender = input("Gender (M/F): ").strip().upper()
            while gender not in ['M', 'F']:
                gender = input("Please enter M or F: ").strip().upper()
            self.students.append(Student(student_id, name, gender))

        print(f"\nRegistered {len(self.students)} students.")

    def setup_rooms(self):
        print("\n--- Room Setup ---")
        try:
            total_rooms = int(input("Enter number of rooms: "))
            if total_rooms <= 0:
                print("Number must be greater than zero.")
                return
        except ValueError:
            print("Please enter a valid number.")
            return

        try:
            capacity = input("Enter room capacity (press Enter for default 3): ").strip()
            self.room_capacity = int(capacity) if capacity else 3
        except ValueError:
            print("Invalid input. Using default capacity of 3.")
            self.room_capacity = 3

        self.rooms = [Room(i + 1, self.room_capacity) for i in range(total_rooms)]
        print(f"{len(self.rooms)} rooms created with capacity {self.room_capacity} each.")

    def allot_rooms(self):
        print("\n--- Allotting Rooms ---")
        total_capacity = len(self.rooms) * self.room_capacity
        if len(self.students) > total_capacity:
            print(f"Not enough room capacity for {len(self.students)} students.")
            print(f"Either reduce students or increase rooms/capacity (Current capacity: {total_capacity})")
            return

        random.shuffle(self.students)
        student_index = 0

        for room in self.rooms:
            while not room.is_full() and student_index < len(self.students):
                room.add_student(self.students[student_index])
                student_index += 1

        print("Allotment complete.\n")

    def display_allotment(self):
        if not self.rooms:
            print("No rooms to display. Please run the allotment first.")
            return

        print("\n--- Room Allotment ---")
        for room in self.rooms:
            print(room)
        print()

    def save_to_file(self):
        if not self.rooms:
            print("No allotment data to save.")
            return

        filename = "hostel_allotment_report.txt"
        with open(filename, 'w') as file:
            file.write("Hostel Room Allotment Report\n")
            file.write("=" * 40 + "\n\n")
            for room in self.rooms:
                file.write(str(room) + "\n")
            file.write("\nTotal Students: {}\n".format(len(self.students)))
            file.write("Total Rooms: {}\n".format(len(self.rooms)))
            file.write("Room Capacity: {}\n".format(self.room_capacity))

        print(f"Allotment saved to {filename}\n")


# --- Main Menu ---

def main():
    system = HostelAllotmentSystem()

    while True:
        print("\n==== Hostel Room Allotment Menu ====")
        print("1. Register Students")
        print("2. Setup Rooms")
        print("3. Allot Rooms")
        print("4. Display Allotment")
        print("5. Save Allotment to File")
        print("6. Exit")

        choice = input("Enter your choice: ").strip()

        if choice == '1':
            system.register_students()
        elif choice == '2':
            system.setup_rooms()
        elif choice == '3':
            system.allot_rooms()
        elif choice == '4':
            system.display_allotment()
        elif choice == '5':
            system.save_to_file()
        elif choice == '6':
            print("Exiting program. Goodbye!")
            break
        else:
            print("Invalid choice. Please select a valid option (1-6).")


# --- Start the Program ---
if __name__ == "__main__":
    main()
